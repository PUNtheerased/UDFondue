# คัดลอกเป็น .env · บน Vercel ใส่ที่ Settings → Environment Variables

# Turnstile → dash.cloudflare.com → Turnstile → Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Supabase → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=

# Apps Script → Deploy → Web app → URL
GAS_WEB_APP_URL=

# LINE Developers → LIFF / Basic settings / Messaging API
NEXT_PUBLIC_LIFF_ID_REPORT=
NEXT_PUBLIC_LIFF_ID_TRACK=
LINE_CHANNEL_ID=
LINE_CHANNEL_ACCESS_TOKEN=

# ตั้งเอง: รหัส /nimda · userId ครูคั่น , · สุ่ม secret ยาว ๆ
ADMIN_PIN=
DEV_PIN=
ADMIN_LINE_IDS=
ADMIN_SESSION_SECRET=

NEXT_PUBLIC_SITE_URL=https://ud-fondue.vercel.app
