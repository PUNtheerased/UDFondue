# คัดลอกเป็น .env · บน Vercel ใส่ที่ Settings → Environment Variables

# Turnstile → dash.cloudflare.com → Turnstile → Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Supabase → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=

# Apps Script → Deploy → Web app → URL
GAS_WEB_APP_URL=

# LINE Developers → LIFF / Basic settings / Messaging API
NEXT_PUBLIC_LIFF_ID_REPORT=
NEXT_PUBLIC_LIFF_ID_TRACK=
NEXT_PUBLIC_LIFF_ID_LOST_FOUND=
LINE_CHANNEL_ID=
LINE_CHANNEL_ACCESS_TOKEN=

# ตั้งเอง: รหัส /nimda · userId ครูคั่น , · สุ่ม secret ยาวอย่างน้อย 16 ตัว (ไม่มีค่านี้แล้วล็อกอินแอดมินไม่ได้)
ADMIN_PIN=
DEV_PIN=
ADMIN_LINE_IDS=
ADMIN_SESSION_SECRET=

# Upstash Redis REST — ถ้าตั้งแล้วแต่ Redis ล่ม ระบบจะปฏิเสธคำขอที่ถูกจำกัดอัตรา (ไม่เปิดให้ยิงต่อ)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# โทเค็น dev: ใช้ได้เฉพาะ next dev บนเครื่อง (ไม่ใช่ Vercel)
# ตั้ง 0 เพื่อปิดแม้ตอนพัฒนา · ตั้ง NEXT_PUBLIC_ALLOW_DEV_LINE_AUTH=1 เฉพาะตอน build เครื่องที่ต้องการปลอม LINE
# ALLOW_DEV_LINE_AUTH=0
# NEXT_PUBLIC_ALLOW_DEV_LINE_AUTH=1

NEXT_PUBLIC_SITE_URL=https://ud-fondue.vercel.app
