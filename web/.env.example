# คัดลอกเป็น .env / .env.local สำหรับรันในเครื่อง
# บน Vercel: Settings → Environment Variables (Production) — ใส่ชื่อเดียวกันทุกตัว
# ค่า NEXT_PUBLIC_* จะถูกฝังฝั่งเบราว์เซอร์ | ค่าอื่นอยู่เฉพาะเซิร์ฟเวอร์

# --- Cloudflare Turnstile (บังคับบน production) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Supabase Storage direct upload (บังคับถ้าจะแนบรูป) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ใช้เฉพาะงาน admin ฝั่งเซิร์ฟเวอร์ — ห้ามใส่ใน client
SUPABASE_SERVICE_ROLE=

# --- Google Apps Script Web App URL (หลัง Deploy New version) ---
GAS_WEB_APP_URL=https://script.google.com/macros/s/XXXX/exec

# --- LINE / LIFF ---
# LIFF ต้องเปิด Scope: profile + openid (จำเป็นสำหรับ getIDToken)
NEXT_PUBLIC_LIFF_ID_REPORT=
NEXT_PUBLIC_LIFF_ID_TRACK=
# Channel ID ของ LINE Login / LIFF channel (ตัวเลข) — ใช้ verify id_token
LINE_CHANNEL_ID=
# ไม่บังคับฝั่ง Next (push อยู่ที่ Code.gs)
LINE_CHANNEL_ACCESS_TOKEN=

# --- Admin ---
# เปลี่ยนรหัสทันทีก่อนขึ้นโรงเรียน
ADMIN_PIN=
# LINE userId ของครู/แอดมิน คั่นด้วย comma (ถ้าใช้ login ด้วย LIFF)
ADMIN_LINE_IDS=
# สุ่มยาว ๆ เช่น openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Public URL ของไซต์ (ลิงก์ติดตามใน LINE) ---
NEXT_PUBLIC_SITE_URL=https://ud-fondue.vercel.app
